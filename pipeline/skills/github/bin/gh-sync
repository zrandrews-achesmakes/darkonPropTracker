#!/usr/bin/env python3
"""Push a local directory tree to a GitHub repo via the Contents API.

Usage:
  gh-sync --repo OWNER/REPO --dir LOCAL_DIR [--branch main] [--message MSG]

Upserts every file under LOCAL_DIR (except .git/) to the repo, creating or
updating as needed. Skips files whose content is unchanged. Each changed file
becomes one API commit. SSH is not required.

Portable auth: uses the Muse Secure Vault helper when available, otherwise
the GITHUB_TOKEN environment variable. This script never sees, prints, or
persists the raw token beyond the requests it signs.
"""
import argparse
import base64
import hashlib
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

sys.path.insert(0, os.path.normpath(
    os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "..")))
from auth import attach_auth, read_json_response, read_response_body

API = "https://api.github.com"
UA = {"User-Agent": "DarkonGithubSkill/1.0",
      "Accept": "application/vnd.github+json"}


def api_request(method, url, payload=None):
    data = None
    headers = dict(UA)
    if payload is not None:
        data = json.dumps(payload).encode("utf-8")
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    attach_auth(req, "github")
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return resp.status, read_json_response(resp)
    except urllib.error.HTTPError as exc:
        body = read_response_body(exc).decode("utf-8", errors="replace")[:500]
        return exc.code, {"_error": body}


def blob_sha(content_bytes):
    """Git blob SHA, matching what the Contents API returns."""
    header = f"blob {len(content_bytes)}\0".encode("ascii")
    return hashlib.sha1(header + content_bytes).hexdigest()


def get_sha(repo, path, branch):
    url = f"{API}/repos/{repo}/contents/{urllib.parse.quote(path)}?ref={urllib.parse.quote(branch)}"
    status, data = api_request("GET", url)
    if status == 200:
        return data.get("sha")
    return None


def put_file(repo, path, content_bytes, branch, message, sha):
    url = f"{API}/repos/{repo}/contents/{urllib.parse.quote(path)}"
    payload = {
        "message": message,
        "content": base64.b64encode(content_bytes).decode("ascii"),
        "branch": branch,
    }
    if sha:
        payload["sha"] = sha
    return api_request("PUT", url, payload)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--repo", required=True, help="OWNER/REPO")
    ap.add_argument("--dir", required=True, help="Local directory to sync")
    ap.add_argument("--branch", default="main")
    ap.add_argument("--message", default="Sync Darkon proposal tracker files")
    args = ap.parse_args()

    local_dir = os.path.abspath(os.path.expanduser(args.dir))
    if not os.path.isdir(local_dir):
        print(f"error: not a directory: {local_dir}", file=sys.stderr)
        return 1

    files = []
    for root, dirs, names in os.walk(local_dir):
        if ".git" in dirs:
            dirs.remove(".git")
        for name in sorted(names):
            full = os.path.join(root, name)
            rel = os.path.relpath(full, local_dir).replace(os.sep, "/")
            files.append((rel, full))

    if not files:
        print("nothing to sync: no files found", file=sys.stderr)
        return 1

    ok, skipped, failed = 0, 0, []
    for rel, full in files:
        with open(full, "rb") as fh:
            content = fh.read()
        sha = get_sha(args.repo, rel, args.branch)
        if sha and sha == blob_sha(content):
            skipped += 1
            continue
        action = "update" if sha else "create"
        status, data = put_file(args.repo, rel, content, args.branch,
                               f"{args.message} ({rel})", sha)
        if status in (200, 201):
            print(f"{action}d: {rel}")
            ok += 1
        else:
            err = data.get("_error", "?") if isinstance(data, dict) else "?"
            print(f"FAILED ({status}): {rel}: {err}", file=sys.stderr)
            failed.append(rel)

    print(f"done: {ok} synced, {skipped} unchanged, {len(failed)} failed")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
